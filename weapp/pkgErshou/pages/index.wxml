<view class="listings-page">
    <view class="listing-search">
        <van-search bind:change="kwSearch" shape="round" placeholder="搜索房源或小区" />
    </view>
    <view class="listing-filters">
        <house-filter bind:change="filterChange" filter="{{filter}}" options="{{filterOption}}" />
    </view>
    <view wx:if="{{filterError}}" class="listing-status" bindtap="loadPostFilter">{{filterError}}</view>
    <view class="listing-results">
        <view wx:for="{{items}}" wx:key="id" class="listing-row">
            <house-item post="{{item}}" />
        </view>
        <view wx:if="{{error}}" class="listing-status" bindtap="loadData">{{error}}</view>
        <view wx:elif="{{loading}}" class="listing-status">正在加载房源…</view>
        <no-result wx:elif="{{!items.length}}" />
        <view wx:elif="{{!hasMore}}" class="listing-status">已显示全部房源</view>
    </view>
</view>
